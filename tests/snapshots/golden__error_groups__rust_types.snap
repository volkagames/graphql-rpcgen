        /// `POST` for an RPC operation, `GET` for a subscription, or an `@http`
        /// operation's `GET`, `PUT`, `PATCH`, `DELETE` or `ANY`, upper-case as
        /// HTTP spells it. `ANY` answers every method.
        pub method: &'static str,
        /// The path the router mounts, `@version` prefix included; an `@http`
        /// path as the SDL writes it, `{name}` segments and all.
        pub path: &'static str,
        /// `@query`, `@mutation` or `@subscription`.
        pub kind: Kind,
        /// What `@auth(require:)` asks, the service's when the operation states none.
        pub auth: Auth,
    }

    /// Every operation, sorted by `path` and then `method`: two operations share
    /// a path only under different methods.
    pub const ALL: &[Operation] = &[
        Operation {
            id: "folders_lock",
            method: "POST",
            path: "/rpc/folders/lock",
            kind: Kind::Mutation,
            auth: Auth::Public,
        },
        Operation {
            id: "folders_mkdir",
            method: "POST",
            path: "/rpc/folders/mkdir",
            kind: Kind::Mutation,
            auth: Auth::Public,
        },
        Operation {
            id: "folders_stat",
            method: "POST",
            path: "/rpc/folders/stat",
            kind: Kind::Query,
            auth: Auth::Public,
        },
    ];

    impl ::treat::rpc::route::RouteRow for Operation {
        fn method(&self) -> &str {
            self.method
        }

        fn path(&self) -> &str {
            self.path
        }
    }

    /// The operation the router mounts at `method path`; `None` for a route it
    /// does not, so a caller that refuses on `None` fails closed. `method` is
    /// matched as spelled: `HEAD`, which a router may answer for a `GET` route,
    /// is no row, and is refused rather than read as the `GET`. An `ANY` row
    /// answers every method, as its route does.
    ///
    /// `path` is the request's (`/api/user/u1`) or the route's (`/api/user/{user_id}`,
    /// a router's matched path): a `{name}` segment of a row takes any one segment.
    /// The route is chosen as the router chooses it, a fixed segment before a
    /// parameter, and only then the method: a method the chosen route lacks is
    /// `None`, as the router answers it `405`, even where another route would fit.
    /// See `treat::rpc::route::by_route`.
    pub fn by_route(method: &str, path: &str) -> Option<&'static Operation> {
        ::treat::rpc::route::by_route(ALL, method, path)
    }

    /// The operation whose `operationId` is `id`; `None` for an id the API lacks,
    /// so a misspelt one never reads as an operation that needs nothing.
    pub fn by_id(id: &str) -> Option<&'static Operation> {
        ALL.iter().find(|op| op.id == id)
    }
}
