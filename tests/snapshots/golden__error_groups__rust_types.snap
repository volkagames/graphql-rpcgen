/// Every operation of the API as its router mounts it, with what the SDL says
/// of it: for code that decides something per operation outside the generated
/// handler, by `(method, path)` or by `operationId`.
pub mod operations {
    /// Which of `@query`, `@mutation` and `@subscription` the operation is.
    #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    pub enum Kind {
        Query,
        Mutation,
        Subscription,
    }

    /// What `@auth(require:)` asks of the caller.
    #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
    pub enum Auth {
        Session,
        Token,
        Public,
    }

    /// One operation, as the router mounts it.
