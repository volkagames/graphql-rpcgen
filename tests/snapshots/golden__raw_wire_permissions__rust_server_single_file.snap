    async fn watch(&self, ctx: &Self::Ctx, input: WatchInput) -> Result<::treat::rpc::server::EventStream<Event>, ::treat::ApiError<AdminWatchCodes>>;

    async fn watch_all(&self, ctx: &Self::Ctx) -> Result<::treat::rpc::server::EventStream<Event>, ::treat::ApiError<AdminWatchAllCodes>>;

    /// A permission the caller lacks, so the call is refused before the service.
