    async fn ingest(&self, ctx: &Self::Ctx, input: IngestInput) -> Result<::treat::ApiResponse<IngestResult>, ::treat::ApiError<AdminIngestCodes>>;

    async fn manifest(&self, ctx: &Self::Ctx) -> Result<::treat::rpc::server::RawBody, ::treat::ApiError<AdminManifestCodes>>;

    /// Inherits a permission the caller holds, so the call reaches the service.
    async fn purge(&self, ctx: &Self::Ctx, input: WatchInput) -> Result<::treat::ApiResponse<IngestResult>, ::treat::ApiError<AdminPurgeCodes>>;

    async fn report(&self, ctx: &Self::Ctx, input: WatchInput) -> Result<::treat::rpc::server::RawBody, ::treat::ApiError<AdminReportCodes>>;

    /// The request body arrives unread as `body`; `input.body` is always empty.
