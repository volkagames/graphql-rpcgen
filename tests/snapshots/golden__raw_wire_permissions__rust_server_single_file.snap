/// Axum router for the `Admin` service.
pub fn admin_router<S: AdminService>(service: S) -> ::axum::Router {
    ::axum::Router::new()
        .route("/admin/convert", ::axum::routing::post(admin_convert::<S>))
        .route("/admin/ingest", ::axum::routing::post(admin_ingest::<S>))
        .route("/admin/manifest", ::axum::routing::post(admin_manifest::<S>))
        .route("/purge", ::axum::routing::post(admin_purge::<S>))
        .route("/admin/report", ::axum::routing::post(admin_report::<S>))
        .route("/admin/upload", ::axum::routing::post(admin_upload::<S>))
        .route("/admin/watch", ::axum::routing::get(admin_watch::<S>))
        .route("/admin/watch_all", ::axum::routing::get(admin_watch_all::<S>))
        .route("/wipe", ::axum::routing::post(admin_wipe::<S>))
        .route("/admin/no_input", ::axum::routing::post(admin_wipe_all::<S>))
        .with_state(service)
}

