    let mut input: IngestInput = Rt::input_from_query(request.uri().query(), wire::ADMIN_CONVERT_FIELDS)?;
    input.body = Rt::raw_body(request, wire::ADMIN_CONVERT_TYPES, ::treat::rpc::server::RAW_BODY_LIMIT).await?;
    Rt::validate(&input)?;
