#[::async_trait::async_trait]
pub trait AdminService: Clone + Send + Sync + 'static {
    /// The caller, resolved from the request before a guarded operation runs.
    ///
    /// An associated type rather than a name from this crate: resolving a session
    /// is the implementation's, and it lives above this one.
