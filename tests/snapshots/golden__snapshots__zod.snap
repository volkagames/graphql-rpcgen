// @generated by graphql-rpcgen. Source of truth: api/**/*.graphql
// DO NOT EDIT MANUALLY.

import { z } from 'zod'

/** Identifies a clan. A UUID on the wire. */
export const ClanIdSchema = z.guid()

export const DateTimeSchema = z.iso.datetime()

export const JSONSchema = z.json()

export const PlayerIdSchema = z.string()

/** A slug: the pattern lives on the scalar, and every use inherits it. */
export const SlugSchema = z.string().regex(/^[a-z0-9-]+$/)

export const UUIDSchema = z.guid()

/** A point in time as whole seconds since the unix epoch. */
export const ZoroTimeSchema = z.number().int().min(0)

export const ErrorCodeSchema = z.enum(['invalid_body', 'internal_error', 'not_found', 'things::gone'])

export const SettingKindSchema = z.enum(['flag', 'number'])

/** A documented enum. */
export const StatusSchema = z.enum(['ACTIVE', 'DISABLED'])

export const CardInputSchema = z.object({
  token: z.string(),
})

export const CreateInputSchema = z.object({
  name: z.string().min(1).max(100),
  age: z.number().int().min(18).max(150).nullish(),
  email: z.string().regex(/^[^@]+@[^@]+$/),
  seen: ZoroTimeSchema,
  /** A field description overrides the scalar's. */
  touched: ZoroTimeSchema.nullish(),
  bounded: z.number().int().min(50).max(100),
  /** On a list, @length counts elements rather than characters. */
  tags: z.array(z.string()).min(1).max(5),
  nested: z.lazy(() => CardInputSchema).nullish(),
})

export const CryptoInputSchema = z.object({
  address: z.string(),
})

export const PaymentInputSchema = z.union([
  z.strictObject({ card: z.lazy(() => CardInputSchema) }),
  z.strictObject({ crypto: z.lazy(() => CryptoInputSchema) }),
  z.strictObject({ nick: z.string().min(1) }),
  z.strictObject({ slug: SlugSchema }),
  z.strictObject({ tag: z.string().regex(/^[a-z]+$/) }),
  z.strictObject({ seen: ZoroTimeSchema }),
])

/** A tree holding itself through a list, which is what makes its schema recursive. */
export const TreeInputSchema: z.ZodTypeAny = z.object({
  id: z.string(),
  children: z.array(z.lazy(() => TreeInputSchema)).nullish(),
})

/** Input schema for every operation that takes one, keyed by its route: the RPC path, or `METHOD path` for an `@http` operation. */
export const inputSchemas: globalThis.Record<string, z.ZodType> = {
  '/rpc/things/get': CreateInputSchema,
  '/rpc/things/make': PaymentInputSchema,
}

/**
 * Check `input` against the operation's declared constraints, throwing zod's own
 * `ZodError` when it does not hold.
 *
 * Pass it to the client as `new RpcClient({ validate: validateInput })` and every
 * call is checked before it leaves the browser. The server checks the same rules
 * from the same declarations, so this only moves the rejection earlier — it
 * cannot accept something the server would refuse.
 *
 * An operation taking no input has no schema and nothing to check.
 */
export function validateInput(route: string, input: unknown): void {
  inputSchemas[route]?.parse(input)
}
