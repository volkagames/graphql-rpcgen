    /// A path parameter, answered bare.
    async fn user(&self, input: UserInput) -> Result<User, ::treat::ApiError<UsersUserCodes>>;

    /// A session and a role, answered bare: both refusals need a status.
    async fn whoami(&self, ctx: &Self::Ctx) -> Result<Me, ::treat::ApiError<UsersWhoamiCodes>>;
}

/// Axum router for the `Users` service.
pub fn users_router<S: UsersService>(service: S) -> ::axum::Router {
    ::axum::Router::new()
        .route("/api/user/new", ::axum::routing::get(users_blank::<S>))
        .route("/api/user_by_email", ::axum::routing::get(users_by_email::<S>))
        .route("/api/user/{user_id}", ::axum::routing::delete(users_drop::<S>))
        .route("/api/info", ::axum::routing::any(users_info::<S>))
        .route("/api/me", ::axum::routing::any(users_me::<S>))
        .route("/items/{id}", ::axum::routing::put(users_rename::<S>))
        .route("/api/user/{user_id}", ::axum::routing::get(users_user::<S>))
        .route("/api/whoami", ::axum::routing::get(users_whoami::<S>))
        .with_state(service)
}

