    input.body = Rt::raw_body(request, wire::FILES_CONVERT_TYPES, ::treat::rpc::server::RAW_BODY_LIMIT).await?;
    Rt::validate(&input)?;
    let result = service.convert(input).await;
    Ok(Rt::respond_raw(result))
}

