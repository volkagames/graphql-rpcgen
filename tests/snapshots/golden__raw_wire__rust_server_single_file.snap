/// Axum router for the `Files` service.
pub fn files_router<S: FilesService>(service: S) -> ::axum::Router {
    ::axum::Router::new()
        .route("/convert", ::axum::routing::post(files_convert::<S>))
        .route("/echo", ::axum::routing::post(files_echo::<S>))
        .route("/ingest", ::axum::routing::post(files_ingest::<S>))
        .route("/manifest", ::axum::routing::post(files_manifest::<S>))
        .route("/report", ::axum::routing::post(files_report::<S>))
        .route("/upload", ::axum::routing::post(files_upload::<S>))
        .route("/watch", ::axum::routing::get(files_watch::<S>))
        .with_state(service)
}

async fn files_convert<S: FilesService>(::axum::extract::State(service): ::axum::extract::State<S>, request: ::axum::extract::Request) -> Result<::axum::response::Response, ::treat::rpc::server::Refusal> {
