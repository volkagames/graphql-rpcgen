// @generated by graphql-rpcgen. Source of truth: api/**/*.graphql
// DO NOT EDIT MANUALLY.

import { z } from 'zod'

export const DateTimeSchema = z.iso.datetime()

export const JSONSchema = z.json()

export const UUIDSchema = z.guid()

export const ErrorCodeSchema = z.enum(['invalid_body', 'internal_error', 'not_found'])

export const FilterSchema = z.object({
  a: z.number().int().nullish(),
})

export const InfoInputSchema = z.object({
  session_id: z.string().nullish(),
  verbose: z.boolean().nullish(),
})

export const RenameInputSchema = z.object({
  id: z.string(),
  name: z.string(),
})

export const SearchInputSchema = z.object({
  filters: z.array(z.lazy(() => FilterSchema)).nullish(),
  one: z.lazy(() => FilterSchema).nullish(),
})

export const UserInputSchema = z.object({
  user_id: z.string(),
})

/** Input schema for every operation that takes one, keyed by its route: the RPC path, or `METHOD path` for an `@http` operation. */
export const inputSchemas: globalThis.Record<string, z.ZodType> = {
  'DELETE /api/user/{user_id}': UserInputSchema,
  'POST /find': SearchInputSchema,
  'POST /api/info': InfoInputSchema,
  'PUT /items/{id}': RenameInputSchema,
  'GET /search': SearchInputSchema,
  'GET /api/user/{user_id}': UserInputSchema,
}

/**
 * Check `input` against the operation's declared constraints, throwing zod's own
 * `ZodError` when it does not hold.
 *
 * Pass it to the client as `new RpcClient({ validate: validateInput })` and every
 * call is checked before it leaves the browser. The server checks the same rules
 * from the same declarations, so this only moves the rejection earlier — it
 * cannot accept something the server would refuse.
 *
 * An operation taking no input has no schema and nothing to check.
 */
export function validateInput(route: string, input: unknown): void {
  inputSchemas[route]?.parse(input)
}
