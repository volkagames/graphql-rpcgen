/** Reaching a path: who may, and whether its storage answers. */
export const AccessCodeSchema = z.enum(['forbidden', 'read_only_storage', 'storage_unavailable', 'internal_error'])

/** Every code the API can answer with; each group's own codes join it. */
export const ErrorCodeSchema = z.enum(['invalid_body', 'internal_error', 'not_found', 'forbidden', 'read_only_storage', 'storage_unavailable', 'kind_conflict', 'name_refused', 'symlink_refused', 'not_supported', 'folder.path-too-deep', 'locked'])

/** Making and changing folders. */
export const FolderCodeSchema = z.enum(['kind_conflict', 'name_refused', 'symlink_refused', 'not_supported', 'folder.path-too-deep', 'forbidden', 'read_only_storage', 'storage_unavailable', 'locked', 'internal_error'])

export const LockCodeSchema = z.enum(['locked', 'internal_error'])

export const PathInputSchema = z.object({
  path: z.string(),
})

/** Input schema for every operation that takes one, keyed by its route: the RPC path, or `METHOD path` for an `@http` operation. */
export const inputSchemas: globalThis.Record<string, z.ZodType> = {
  '/rpc/folders/lock': PathInputSchema,
  '/rpc/folders/mkdir': PathInputSchema,
  '/rpc/folders/stat': PathInputSchema,
