// @generated by graphql-rpcgen. Source of truth: api/**/*.graphql
// DO NOT EDIT MANUALLY.

import { z } from 'zod'

/** An opaque body: bytes on the wire rather than a value in the JSON envelope. */
export const BinarySchema = z.unknown()

export const DateTimeSchema = z.iso.datetime()

export const JSONSchema = z.json()

export const UUIDSchema = z.guid()

export const ErrorCodeSchema = z.enum(['invalid_body', 'internal_error', 'not_found', 'role_required', 'database_error', 'files::gone'])

/** A junior role and one inheriting it, so the guard below passes by inheritance. */
export const RoleSchema = z.enum(['files_read', 'files_write'])

/** What a token may do; one scope tagged, so its wire name is not its identifier. */
export const ScopeSchema = z.enum(['read', 'write', 'files.purge'])

export const ConvertInputSchema = z.object({
  id: UUIDSchema,
  body: BinarySchema,
})

export const IngestInputSchema = z.object({
  id: UUIDSchema,
  /** A list repeats its key in the query string once the body is spent. */
  tags: z.array(z.string()).nullish(),
  /** The one binary field: this is the request body itself. */
  body: BinarySchema,
})

export const ReportInputSchema = z.object({
  id: UUIDSchema,
  /** A parameter of a raw-response call still travels as JSON. */
  rows: z.number().int().nullish(),
})

export const UploadInputSchema = z.object({
  id: UUIDSchema,
  /** Left empty by the server: the payload reaches the service unread. */
  body: BinarySchema,
})

export const WatchInputSchema = z.object({
  id: UUIDSchema,
})

/** Input schema for every operation that takes one, keyed by its route: the RPC path, or `METHOD path` for an `@http` operation. */
export const inputSchemas: globalThis.Record<string, z.ZodType> = {
  '/convert': ConvertInputSchema,
  '/echo': ConvertInputSchema,
  '/ingest': IngestInputSchema,
  '/report': ReportInputSchema,
  '/upload': UploadInputSchema,
  '/watch': WatchInputSchema,
}

/**
 * Check `input` against the operation's declared constraints, throwing zod's own
 * `ZodError` when it does not hold.
 *
 * Pass it to the client as `new RpcClient({ validate: validateInput })` and every
 * call is checked before it leaves the browser. The server checks the same rules
 * from the same declarations, so this only moves the rejection earlier — it
 * cannot accept something the server would refuse.
 *
 * An operation taking no input has no schema and nothing to check.
 */
export function validateInput(route: string, input: unknown): void {
  inputSchemas[route]?.parse(input)
}
