  "tags": [
    {
      "name": "Admin",
      "description": "Neither exposed nor versioned unless an operation says so."
    },
    {
      "name": "Catalog",
      "description": "Exposed to MCP as a whole and mounted under `/v1`: every operation inherits\nboth unless it restates one."
    }
