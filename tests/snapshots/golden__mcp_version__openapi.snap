  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_body",
          "internal_error"
        ]
      },
      "GetInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id"
        ]
      },
      "RenameInput": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Thing": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "RpcErrorItem": {
        "type": "object",
        "description": "One entry of `errors[]`, as produced by `treat::ErrorMessage`.",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "meta": {
            "type": "object",
            "description": "Free-form context; its keys depend on the code."
          },
          "type": {
            "type": "string",
            "description": "RFC 9457 problem type URI."
          },
          "instance": {
            "type": "string",
            "description": "RFC 9457 occurrence id."
          },
          "source": {
            "type": "object",
            "description": "Locator for the offending input (JSON:API `source`).",
            "properties": {
              "pointer": {
                "type": "string",
                "description": "RFC 6901 JSON Pointer."
              },
              "parameter": {
                "type": "string"
              },
              "header": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "code"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RpcErrorItem"
            }
          }
        },
        "required": [
          "errors"
        ]
      }
    },
    "headers": {
      "x-rpc-status": {
        "description": "`ok` when `errors[]` is empty, `error` otherwise.",
        "schema": {
          "type": "string",
          "enum": [
            "ok",
            "error"
          ]
        }
      }
    }
  }
