// --- @http operations --------------------------------------------------------
//
// Emitted only for an API with an `@http` operation.

/// Where an `@http` operation reads the fields its path does not carry.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum HttpBodyKind {
    /// The query string only.
    None,
    /// The input object as a JSON body.
    Json,
    /// The query string and an `application/x-www-form-urlencoded` body over
    /// it: a field present in both takes the body's value.
    Form,
}

/// Give a failure the status an `@http` caller reads.
///
/// The envelope's own failures answer `200`, since an RPC caller reads
/// `errors[]`; an endpoint bound to HTTP is read by callers that look at the
/// status line, so one that could not read its input says so there: `400`, or
/// whatever the body's rejection carried (`413` for one too large). A missing
/// session answers `401` and a denied one `403`, and the service's own failure
/// of an operation answered bare `500`: there a `200` would read as success.
/// A status the failure already carries other than `200` is kept.
fn http_status(mut response: Response, status: axum::http::StatusCode) -> Response {
    if response.status() == axum::http::StatusCode::OK {
        *response.status_mut() = status;
    }
    response
}

/// Read an `@http` operation's input from its request.
///
/// The path parameters win over everything else: they are what the route
/// matched, so a body or a query string naming the same field cannot point the
/// operation somewhere else. A form body that is not declared as one is not
/// read, which is how a form extractor behaves too: an endpoint answering
/// several methods gets a GET's empty body as often as a POST's form.
async fn http_input<T: serde::de::DeserializeOwned>(
    request: axum::extract::Request,
    fields: &[QueryField],
    path_fields: &[&str],
    body: HttpBodyKind,
) -> Result<T, Response> {
    read_http_input(request, fields, path_fields, body)
        .await
        .map_err(|response| http_status(response, axum::http::StatusCode::BAD_REQUEST))
}

async fn read_http_input<T: serde::de::DeserializeOwned>(
    request: axum::extract::Request,
    fields: &[QueryField],
    path_fields: &[&str],
    body: HttpBodyKind,
) -> Result<T, Response> {
    let (mut parts, request_body) = request.into_parts();
    let params = <axum::extract::RawPathParams as axum::extract::FromRequestParts<()>>::from_request_parts(
        &mut parts,
        &(),
    )
    .await;
    let params = match params {
        Ok(params) => params,
        Err(rejection) => return Err(invalid_query(&rejection.body_text(), None)),
    };
    let path_pairs: Vec<(String, String)> = params
        .iter()
        .filter(|(key, _)| path_fields.contains(key))
        .map(|(key, value)| (key.to_string(), value.to_string()))
        .collect();

    if body == HttpBodyKind::Json {
        let request = axum::extract::Request::from_parts(parts, request_body);
        let read = <ApiJson<serde_json::Map<String, serde_json::Value>> as axum::extract::FromRequest<()>>::from_request(
            request,
            &(),
        )
        .await;
        let mut object = match read {
            Ok(ApiJson(object)) => object,
            Err(response) => return Err(response),
        };
        for (key, raw) in &path_pairs {
            let field = fields.iter().find(|field| field.name == key.as_str());
            let value = match field {
                Some(field) => query_value(field, raw)?,
                None => serde_json::Value::String(raw.clone()),
            };
            object.insert(key.clone(), value);
        }
        return serde_json::from_value(serde_json::Value::Object(object))
            .map_err(|e| invalid_query(&e.to_string(), None));
    }

    let mut pairs = url_pairs(parts.uri.query().unwrap_or_default().as_bytes())?;
    let is_form = parts
        .headers
        .get(axum::http::header::CONTENT_TYPE)
        .and_then(|value| value.to_str().ok())
        .is_some_and(|value| {
            // A media type is case-insensitive: `Application/X-WWW-Form-Urlencoded`
            // is the same form.
            const FORM: &str = "application/x-www-form-urlencoded";
            value.get(..FORM.len()).is_some_and(|start| start.eq_ignore_ascii_case(FORM))
        });
    if body == HttpBodyKind::Form && is_form {
        let request = axum::extract::Request::from_parts(parts, request_body);
        let read = <axum::body::Bytes as axum::extract::FromRequest<()>>::from_request(request, &()).await;
        let bytes = match read {
            Ok(bytes) => bytes,
            Err(rejection) => {
                let status = axum::response::IntoResponse::into_response(rejection).status();
                return Err(http_status(invalid_query("the form body cannot be read", None), status));
            }
        };
        let form = url_pairs(&bytes)?;
        override_pairs(&mut pairs, form);
    }
    override_pairs(&mut pairs, path_pairs);
    input_from_pairs(&pairs, fields)
}

/// Replace every pair whose key `newer` names with `newer`'s pairs for it.
///
/// Per key rather than per pair, so a list field repeated in the body replaces
/// the query string's list as a whole instead of being merged into it.
fn override_pairs(pairs: &mut Vec<(String, String)>, newer: Vec<(String, String)>) {
    pairs.retain(|(key, _)| !newer.iter().any(|(new_key, _)| new_key == key));
    pairs.extend(newer);
}
