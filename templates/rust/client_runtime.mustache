
// --- streaming and raw bodies ------------------------------------------------
//
// Emitted only for an API that has a `@subscription` or a `@raw` operation, so
// a plain JSON client compiles none of it.

use std::collections::VecDeque;

/// A stream of events, which is what a `@subscription` answers with.
///
/// Each item is one event or the reason the stream stopped being readable.
/// Opening the subscription is a separate, earlier failure: a server that
/// refuses answers with the envelope, so that arrives as `ClientError`.
pub type EventStream<T> =
    std::pin::Pin<Box<dyn futures_core::Stream<Item = Result<T, StreamError>> + Send>>;

/// Why a subscription stopped before the server closed it.
#[derive(Debug)]
pub enum StreamError {
    /// The connection dropped mid-stream.
    Transport(String),
    /// A frame arrived that was not the declared event type.
    Decode(String),
}

impl std::fmt::Display for StreamError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            StreamError::Transport(m) => write!(f, "stream transport error: {m}"),
            StreamError::Decode(m) => write!(f, "could not decode event: {m}"),
        }
    }
}

impl std::error::Error for StreamError {}

/// Whether a response carries the JSON envelope rather than the bytes asked for.
///
/// How a failure is told from a body: a `@raw` operation answers with its own
/// content type when it succeeds and with `application/json` when it does not.
fn is_envelope(response: &reqwest::Response) -> bool {
    response
        .headers()
        .get(reqwest::header::CONTENT_TYPE)
        .and_then(|value| value.to_str().ok())
        .is_some_and(|value| value.starts_with("application/json"))
}

/// Read the failure envelope out of a response that carries one.
async fn envelope_error<C>(response: reqwest::Response) -> ClientError<C> {
    let status = response.status();
    let body = match response.bytes().await {
        Ok(body) => body,
        Err(e) => return ClientError::Transport(e.to_string()),
    };
    match serde_json::from_slice::<ApiResponse<serde_json::Value>>(&body) {
        Ok(envelope) if !envelope.errors.is_empty() => {
            ClientError::Api(ApiErrors::new(envelope.errors))
        }
        Ok(_) => ClientError::Status(status.as_u16()),
        Err(e) => {
            if status.is_success() {
                ClientError::Decode(e.to_string())
            } else {
                ClientError::Status(status.as_u16())
            }
        }
    }
}

/// An input as a query string.
///
/// The mirror of what the server decodes: absent values are left out rather
/// than sent empty, a list repeats its key, and anything with no query-string
/// spelling of its own travels as JSON text.
fn to_query<I: Serialize>(input: &I) -> Result<String, String> {
    let value = serde_json::to_value(input).map_err(|e| e.to_string())?;
    let serde_json::Value::Object(fields) = value else {
        return Ok(String::new());
    };

    let mut pairs: Vec<(String, String)> = Vec::new();
    for (key, value) in fields {
        match value {
            serde_json::Value::Null => continue,
            serde_json::Value::Array(items) => {
                for item in items {
                    pairs.push((key.clone(), scalar_param(item)));
                }
            }
            value => pairs.push((key, scalar_param(value))),
        }
    }
    if pairs.is_empty() {
        return Ok(String::new());
    }

    let query = pairs
        .iter()
        .map(|(key, value)| {
            format!(
                "{}={}",
                urlencode(key),
                urlencode(value)
            )
        })
        .collect::<Vec<_>>()
        .join("&");
    Ok(format!("?{query}"))
}

/// One parameter's text. A string travels as itself rather than as a quoted
/// JSON string, which is what the server reads it back as.
fn scalar_param(value: serde_json::Value) -> String {
    match value {
        serde_json::Value::String(s) => s,
        other => other.to_string(),
    }
}

/// Percent-encode everything a query parameter may not carry literally.
fn urlencode(value: &str) -> String {
    let mut out = String::with_capacity(value.len());
    for byte in value.as_bytes() {
        match byte {
            b'A'..=b'Z' | b'a'..=b'z' | b'0'..=b'9' | b'-' | b'_' | b'.' | b'~' => {
                out.push(*byte as char)
            }
            b' ' => out.push('+'),
            other => out.push_str(&format!("%{other:02X}")),
        }
    }
    out
}

/// Split whatever complete SSE frames the buffer holds into their `data` texts.
fn drain_frames(buffer: &mut Vec<u8>, ready: &mut VecDeque<String>) {
    while let Some((end, separator)) = frame_end(buffer) {
        let frame: Vec<u8> = buffer.drain(..end).collect();
        buffer.drain(..separator);

        let Ok(text) = String::from_utf8(frame) else {
            continue;
        };
        // A frame may carry several `data:` lines, which the spec joins with a
        // newline. A frame with none is a comment or a keep-alive.
        let mut data = String::new();
        for line in text.lines() {
            let Some(rest) = line.strip_prefix("data:") else {
                continue;
            };
            if !data.is_empty() {
                data.push('\n');
            }
            data.push_str(rest.strip_prefix(' ').unwrap_or(rest));
        }
        if !data.is_empty() {
            ready.push_back(data);
        }
    }
}

/// Offset of the first frame boundary, and the length of the boundary itself.
fn frame_end(buffer: &[u8]) -> Option<(usize, usize)> {
    let lf = buffer.windows(2).position(|w| w == b"\n\n").map(|i| (i, 2));
    let crlf = buffer
        .windows(4)
        .position(|w| w == b"\r\n\r\n")
        .map(|i| (i, 4));
    match (lf, crlf) {
        (Some(lf), Some(crlf)) => Some(std::cmp::min(lf, crlf)),
        (found, None) | (None, found) => found,
    }
}

/// State threaded through the unfolded SSE stream.
struct SseState {
    bytes: std::pin::Pin<Box<dyn futures_core::Stream<Item = reqwest::Result<bytes::Bytes>> + Send>>,
    buffer: Vec<u8>,
    ready: VecDeque<String>,
    /// Set once the stream has reported a transport failure, so it ends there
    /// instead of reporting the same failure for every later poll.
    failed: bool,
}

/// Turn an open SSE response into a stream of decoded events.
fn sse_stream<O: serde::de::DeserializeOwned + Send + 'static>(
    response: reqwest::Response,
) -> EventStream<O> {
    let state = SseState {
        bytes: Box::pin(futures_util::StreamExt::map(
            response.bytes_stream(),
            |chunk| chunk,
        )),
        buffer: Vec::new(),
        ready: VecDeque::new(),
        failed: false,
    };

    Box::pin(futures_util::stream::unfold(state, |mut state| async move {
        loop {
            if let Some(data) = state.ready.pop_front() {
                let event = serde_json::from_str::<O>(&data)
                    .map_err(|e| StreamError::Decode(e.to_string()));
                return Some((event, state));
            }
            if state.failed {
                return None;
            }
            match futures_util::StreamExt::next(&mut state.bytes).await {
                Some(Ok(chunk)) => {
                    state.buffer.extend_from_slice(&chunk);
                    drain_frames(&mut state.buffer, &mut state.ready);
                }
                Some(Err(e)) => {
                    state.failed = true;
                    return Some((Err(StreamError::Transport(e.to_string())), state));
                }
                // The server closed the stream. A trailing partial frame is
                // incomplete by definition, so it is dropped rather than parsed.
                None => return None,
            }
        }
    }))
}

impl {{{client_name}}} {
    /// Open a subscription over Server-Sent Events.
    ///
    /// `EventSource` semantics without `EventSource`: the input travels in the
    /// query string because the request is a GET, and each `data:` frame is one
    /// JSON event of the declared type. Dropping the returned stream closes the
    /// connection; unlike a browser's `EventSource`, nothing reconnects on its
    /// own.
    pub async fn subscribe<I, O, C>(&self, path: &str, input: &I) -> ClientResult<EventStream<O>, C>
    where
        I: Serialize,
        O: DeserializeOwned + Send + 'static,
    {
        let query = to_query(input).map_err(ClientError::Decode)?;
        let response = self
            .http
            .get(format!("{}{path}{query}", self.base_url))
            .header(reqwest::header::ACCEPT, "text/event-stream")
            .send()
            .await
            .map_err(|e| ClientError::Transport(e.to_string()))?;

        // A refusal answers with the envelope rather than with a stream, so it
        // is reported here instead of as an event that never arrives.
        if !response.status().is_success() || is_envelope(&response) {
            return Err(envelope_error(response).await);
        }
        Ok(sse_stream(response))
    }

    /// Call an operation whose answer is the bytes rather than the envelope.
    ///
    /// The whole response is returned, so the headers that describe the body —
    /// `Content-Disposition`, `Content-Type` — are readable, and a long one can
    /// be read incrementally instead of buffered.
    pub async fn raw<I: Serialize, C>(
        &self,
        path: &str,
        input: &I,
    ) -> ClientResult<reqwest::Response, C> {
        let response = self
            .http
            .post(format!("{}{path}", self.base_url))
            .json(input)
            .send()
            .await
            .map_err(|e| ClientError::Transport(e.to_string()))?;

        if !response.status().is_success() || is_envelope(&response) {
            return Err(envelope_error(response).await);
        }
        Ok(response)
    }

    /// Send a body of bytes, with the input's other fields as query parameters.
    ///
    /// The payload has the one body, which is why everything else is in the URL.
    /// `content_type` says what the bytes are: the SDL lists what the operation
    /// accepts, and only the caller knows which of them it is sending.
    pub async fn raw_request<I: Serialize, C>(
        &self,
        path: &str,
        input: &I,
        body: Vec<u8>,
        content_type: &str,
    ) -> ClientResult<reqwest::Response, C> {
        let query = to_query(input).map_err(ClientError::Decode)?;
        let response = self
            .http
            .post(format!("{}{path}{query}", self.base_url))
            .header(reqwest::header::CONTENT_TYPE, content_type)
            .body(body)
            .send()
            .await
            .map_err(|e| ClientError::Transport(e.to_string()))?;

        if !response.status().is_success() {
            return Err(envelope_error(response).await);
        }
        Ok(response)
    }

    /// A raw request whose answer is an ordinary envelope — an upload
    /// reporting what it wrote.
    pub async fn raw_request_json<I: Serialize, O: DeserializeOwned, C>(
        &self,
        path: &str,
        input: &I,
        body: Vec<u8>,
        content_type: &str,
    ) -> ClientResult<O, C> {
        let response = self
            .raw_request::<I, C>(path, input, body, content_type)
            .await?;
        let status = response.status();
        let body = response
            .bytes()
            .await
            .map_err(|e| ClientError::Transport(e.to_string()))?;

        let envelope: ApiResponse<O> =
            serde_json::from_slice(&body).map_err(|e| ClientError::Decode(e.to_string()))?;
        if !envelope.errors.is_empty() {
            return Err(ClientError::Api(ApiErrors::new(envelope.errors)));
        }
        match envelope.data {
            Some(data) => Ok(data),
            None => Err(ClientError::Status(status.as_u16())),
        }
    }
}
